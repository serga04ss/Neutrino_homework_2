import numpy as np

class Source:
    def __init__(self, Y=10000):
        self.Y = Y

    def generate_photons_generator(self, energy, batch_size=100):
  
        # Пуассон
        total_photons = np.random.poisson(self.Y * energy)
        generated = 0
        
        while generated < total_photons:
            current_batch = min(batch_size, total_photons - generated)
            
            # Изотропные направления для пакета
            cos_theta = np.random.uniform(-1, 1, current_batch)
            theta = np.arccos(cos_theta)
            phi = np.random.uniform(0, 2 * np.pi, current_batch)
            
            dx = np.sin(theta) * np.cos(phi)
            dy = np.sin(theta) * np.sin(phi)
            dz = np.cos(theta)
            
            directions = np.column_stack((dx, dy, dz))
          
            yield directions 
            generated += current_batch
