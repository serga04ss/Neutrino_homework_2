import numpy as np
import time

# МЕДЛЕННЫЙ 
def check_hits_slow(origin, dirs, pmt_coords, R, r):
    hits = 0
    ox, oy, oz = origin
    
    for d in dirs:
        dx, dy, dz = d
        A = dx**2 + dy**2 + dz**2 
        B = 2 * (ox * dx + oy * dy + oz * dz)
        C = ox**2 + oy**2 + oz**2 - R**2
        
        discriminant = B**2 - 4 * A * C
        if discriminant >= 0:
            t = (-B + np.sqrt(discriminant)) / (2 * A)
            if t > 0:
                hit_x, hit_y, hit_z = ox + t*dx, oy + t*dy, oz + t*dz
                
                min_dist = float('inf')
                for pmt in pmt_coords:
                    dist = np.sqrt((pmt[0]-hit_x)**2 + (pmt[1]-hit_y)**2 + (pmt[2]-hit_z)**2)
                    if dist < min_dist:
                        min_dist = dist
                if min_dist <= r:
                    hits += 1
    return hits

# БЫСТРЫЙ 
def check_hits_fast(origin, dirs, pmt_coords, R, r):
            A = 1.0 
            B = 2 * np.dot(dirs, origin)
            C = np.sum(origin**2) - R**2
            discriminant = B**2 - 4 * A * C
            
            valid = discriminant >= 0
            if not np.any(valid): return 0
                
            t1 = (-B - np.sqrt(discriminant)) / (2 * A)
            t2 = (-B + np.sqrt(discriminant)) / (2 * A)
            t = np.where(t2 > 0, t2, t1)
            valid &= (t > 0)
            if not np.any(valid): return 0
                
            hit_points = origin + t[valid, np.newaxis] * dirs[valid]
            dists = t[valid]
            dists = np.linalg.norm(hit_points[:, np.newaxis, :] - pmt_coords[np.newaxis, :, :], axis=2)
            min_dists = np.min(dists, axis=1)
            return np.sum(min_dists <= r)

# СРАВНЕНИЕ
if __name__ == "__main__":
    
    N_photons = 100000
    origin = np.array([0.0, 0.0, 0.0])
    
    cos_theta = np.random.uniform(-1, 1, N_photons)
    theta = np.arccos(cos_theta)
    phi = np.random.uniform(0, 2 * np.pi, N_photons)
    dirs = np.column_stack((np.sin(theta)*np.cos(phi), np.sin(theta)*np.sin(phi), np.cos(theta)))
    
    N_pmts = 40
    z = np.random.uniform(-2.0, 2.0, N_pmts)
    phi_pmt = np.random.uniform(0, 2 * np.pi, N_pmts)
    r_xy = np.sqrt(2.0**2 - z**2)
    pmt_coords = np.column_stack((r_xy*np.cos(phi_pmt), r_xy*np.sin(phi_pmt), z))
    
    # МЕДЛЕННЫЙ
    t0 = time.perf_counter()
    hits_slow = check_hits_slow(origin, dirs, pmt_coords, R=2.0, r=0.1)
    t1 = time.perf_counter()
    time_slow = t1 - t0
    
    # БЫСТРЫЙ
    t0 = time.perf_counter()
    hits_fast = check_hits_fast(origin, dirs, pmt_coords, R=2.0, r=0.1)
    t1 = time.perf_counter()
    time_fast = t1 - t0
    
    print(f"\nВЫИГРЫШ В СКОРОСТИ:  {time_slow / time_fast:.1f} раз")
